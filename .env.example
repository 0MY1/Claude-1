# ============================================================
# EXCHANGE CREDENTIALS
# ============================================================

# Which exchange are you using? (bitget, binance, bybit, okx, coinbase, kraken, kucoin, gateio, mexc, bitfinex)
EXCHANGE=bitget

# Your exchange API credentials
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
API_PASSPHRASE=your_passphrase_here   # Not all exchanges use this — leave blank if yours doesn't

# ============================================================
# TRADING PREFERENCES
# ============================================================

# Total portfolio value you're working with (USD)
PORTFOLIO_VALUE_USD=1000

# Maximum size of any single trade (USD)
MAX_TRADE_SIZE_USD=50

# Maximum number of trades per day
MAX_TRADES_PER_DAY=3

# Trading symbol (e.g. BTC/USDT, ETH/USDT)
SYMBOL=BTC/USDT

# ============================================================
# BOT BEHAVIOUR
# ============================================================

# Paper trading mode — set to false only when you're ready to go live
PAPER_TRADING=true

# Timezone for scheduling (e.g. UTC, America/New_York)
TIMEZONE=UTC

# ============================================================
# OPTIONAL INTEGRATIONS
# ============================================================

# Apify API key (required only for YouTube strategy scraping in Step 4)
APIFY_API_KEY=

# TradingView webhook secret (if using webhook-based alerts)
TV_WEBHOOK_SECRET=
