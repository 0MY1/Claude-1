# All of these live in the repo-root .env (shared with the rest of the repo), not
# in this directory — config.py loads ../.env automatically.

# Required
HELIUS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required only to submit live swaps (base58-encoded Solana keypair secret key)
SOLANA_PRIVATE_KEY=

# Optional
JUPITER_API_KEY=                      # raises the free lite-api.jup.ag rate limit
SOLANA_RPC_URL=                       # defaults to Helius's RPC using HELIUS_API_KEY
PAPER_TRADING=true                    # set to false to let execute_buy() send real transactions
BUY_AMOUNT_SOL=0.1                    # position size per approved buy
SLIPPAGE_BPS=100
PORT=5000

MIN_BUY_USD=150
CONVERGENCE_WINDOW_SECONDS=480        # 8 minutes
MIN_CONVERGENCE_WALLETS=3
APPROVAL_TTL_SECONDS=600              # stale approvals are skipped instead of executed

# Dashboard (/dashboard) — display-only list of wallets, and the Basic Auth password.
# Leaving DASHBOARD_PASSWORD unset disables the dashboard route entirely (503).
TRACKED_WALLETS=                      # comma-separated, e.g. wallet1,wallet2,wallet3
DASHBOARD_PASSWORD=
